90. Reverse a singly linked list recursively. The function prototype is 
node * reverse (node *) ; 

ANS. 

    node * reverse (node * n)
      {
         node * m ;

         if (! (n && n -> next))
           return n ;
         
         m = reverse (n -> next) ;
         n -> next -> next = n ;
         n -> next = NULL ;
         return m ;
      }

